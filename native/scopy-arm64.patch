--- a/src/main.cpp
+++ b/src/main.cpp
@@ -108,6 +108,17 @@ int main(int argc, char **argv)
 	qputenv("PYTHONPATH", path_str.toLocal8Bit());
 #endif
 
+#ifdef Q_OS_MACOS
+	// Relocatable embedded Python for the standalone Apple Silicon bundle.
+	QDir pythonHome(QCoreApplication::applicationDirPath() + "/../Resources/python");
+	if (pythonHome.exists("lib/" PYTHON_VERSION "/encodings")) {
+		qputenv("PYTHONHOME", pythonHome.absolutePath().toUtf8());
+		qunsetenv("PYTHONPATH");
+		qputenv("PYTHONDONTWRITEBYTECODE", "1");
+		qputenv("SCOPY_BUNDLED_DECODERS_ONLY", "1");
+	}
+#endif
+
 	QCoreApplication::setOrganizationName("ADI");
 	QCoreApplication::setOrganizationDomain("analog.com");
 	QCoreApplication::setApplicationName("Scopy");
